---
import { getPosts } from '../lib/posts';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 新しい順に並べて、トップには5件だけ出す
const posts = (await getPosts()).slice(0, 5);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>

			<h2>最新の記事</h2>
			{
				posts.length === 0 ? (
					<p>まだ記事がありません。<code>src/content/blog/</code> に Markdown を置くとここに並びます。</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								<a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
								<p class="desc">{post.data.description}</p>
							</li>
						))}
					</ul>
				)
			}
			<p><a href="/blog">記事をすべて見る →</a></p>
		</main>
		<Footer />
	</body>
</html>
<style>
	.lead {
		color: rgb(var(--gray));
	}
	.post-list {
		list-style: none;
		margin: 0 0 2em 0;
		padding: 0;
	}
	.post-list li {
		padding: 1.25em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-list .date {
		margin: 0 0 0.2em 0;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	.post-list .title {
		font-size: 1.15em;
		font-weight: 700;
		text-decoration: none;
	}
	.post-list .title:hover {
		text-decoration: underline;
	}
	.post-list .desc {
		margin: 0.3em 0 0 0;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
</style>
