---
import { getPosts } from '../lib/posts';
import Page from '../layouts/Page.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { url } from '../lib/url';

// 新しい順に並べて、トップには5件だけ出す
const posts = (await getPosts()).slice(0, 5);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1>{SITE_TITLE}</h1>
	<p class="lead">{SITE_DESCRIPTION}</p>

	<h2>最新の記事</h2>
	{
		posts.length === 0 ? (
			<p>
				まだ記事がありません。<code>src/content/blog/</code> に Markdown を置くとここに並びます。
			</p>
		) : (
			<PostList posts={posts} />
		)
	}
	<p class="more"><a href={url('/posts')}>記事をすべて見る →</a></p>
</Page>

<style>
	.lead {
		color: rgb(var(--gray));
	}
	.more {
		margin-top: 2em;
	}
</style>
