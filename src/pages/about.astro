---
// 中身は src/content/pages/about.md にある。エディタから編集できるようにするため。
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { SITE_TITLE, SOCIALS } from '../consts';

const entry = await getEntry('pages', 'about');
const { Content } = entry ? await render(entry) : { Content: null };
---

<Page
	title={`${entry?.data.title ?? 'About'} | ${SITE_TITLE}`}
	description={entry?.data.description ?? ''}
>
	<h1>{entry?.data.title ?? 'About'}</h1>
	{Content ? <Content /> : <p>準備中です。</p>}

	{
		SOCIALS.length > 0 && (
			<>
				<h2>リンク</h2>
				<ul>
					{SOCIALS.map((s) => (
						<li>
							<a href={s.href} target="_blank" rel="me noopener">
								{s.label}
							</a>
						</li>
					))}
				</ul>
			</>
		)
	}
</Page>
