---
import { getPosts } from '../../lib/posts';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getPosts();
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`ブログ | ${SITE_TITLE}`} description="これまでに書いた記事の一覧。" />
	</head>
	<body>
		<Header />
		<main>
			<h1>ブログ</h1>
			{
				posts.length === 0 ? (
					<p>まだ記事がありません。</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								<a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
								<p class="desc">{post.data.description}</p>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		padding: 1.25em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-list .date {
		margin: 0 0 0.2em 0;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	.post-list .title {
		font-size: 1.15em;
		font-weight: 700;
		text-decoration: none;
	}
	.post-list .title:hover {
		text-decoration: underline;
	}
	.post-list .desc {
		margin: 0.3em 0 0 0;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
</style>
