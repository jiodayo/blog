---
import { AUTHOR } from '../consts';

const today = new Date();
---

<footer>
	<p class="copyright">&copy; {today.getFullYear()} {AUTHOR}</p>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	.copyright {
		margin: 0;
	}
</style>
