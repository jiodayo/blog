---
import { SITE_TITLE, SOCIALS } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { url } from '../lib/url';
---

<header>
	<nav>
		<h2>
			<a href={url('/')}>{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/posts">ブログ</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			{
				SOCIALS.map((s) => (
					<a href={s.href} target="_blank" rel="me noopener">
						{s.label}
					</a>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.95em;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		nav a {
			padding: 1em 0.35em;
		}
	}
</style>
