---
// 記事に付いたタグを並べる。記事ページと一覧の両方で使う。
import { tagUrl } from '../lib/posts';

interface Props {
	tags: string[];
	class?: string;
}
const { tags, class: className } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class:list={['tag-list', className]}>
			{tags.map((tag) => (
				<li>
					<a href={tagUrl(tag)}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		list-style: none;
		margin: 0.5em 0 0 0;
		padding: 0;
		font-size: 0.85em;
	}
	.tag-list a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.tag-list a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
</style>
